{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창의 권한. 화면이 쓰는 것만 연다(D-037).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-app-status",
    "allow-app-open-git-download",
    "allow-app-open-log-folder",
    "allow-project-open",
    "allow-project-trust",
    "allow-project-allow-owner",
    "allow-recent-list",
    "allow-recent-remove",
    "allow-action-list",
    "allow-action-preview",
    "allow-action-execute",
    "allow-action-cancel",
    "allow-undo-last",
    "allow-redo-last",
    "allow-query-status",
    "allow-query-log",
    "allow-query-diff",
    "allow-query-branches",
    "allow-query-branch-name",
    "allow-query-home-map",
    "allow-query-secret-check",
    "allow-query-merge-hint",
    "allow-query-stashes",
    "allow-query-recovery",
    "allow-query-pending-work",
    "allow-query-conflict-state",
    "allow-query-conflict-file",
    "allow-query-project-summary",
    "allow-repo-watch",
    "allow-repo-unwatch"
