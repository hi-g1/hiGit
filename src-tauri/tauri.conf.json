{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hiGit",
  "mainBinaryName": "higit",
  "version": "0.1.0",
  "identifier": "dev.higit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hiGit",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560,
        "zoomHotkeysEnabled": false,
        "visible": false,
        "backgroundColor": "#fafaf9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "hiGit contributors",
    "copyright": "Copyright (c) 2026 hiGit contributors",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Git을 모르는 사람도 쉽게 쓰는 데스크톱 Git 앱",
    "longDescription": "hiGit은 버전 저장, 비교, 되돌리기, 브랜치, 합치기와 충돌 해결, GitHub 동기화를 쉬운 낱말로 보여 주는 데스크톱 Git 앱입니다. Git이 따로 설치되어 있어야 합니다.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../assets/fonts/licenses/Pretendard-OFL.txt": "licenses/Pretendard-OFL.txt",
      "../assets/fonts/licenses/JetBrainsMono-OFL.txt": "licenses/JetBrainsMono-OFL.txt",
      "../src/assets/fonts/D2Coding-OFL.txt": "licenses/D2Coding-OFL.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "../packaging/windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["git"],
        "section": "vcs",
        "desktopTemplate": "../packaging/linux/higit.desktop",
        "files": {
          "/usr/share/doc/higit/copyright": "../LICENSE",
          "/usr/share/doc/higit/THIRD_PARTY_NOTICES.md": "../THIRD_PARTY_NOTICES.md",
          "/usr/share/doc/higit/THIRD_PARTY_LICENSES.txt": "../THIRD_PARTY_LICENSES.txt"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
